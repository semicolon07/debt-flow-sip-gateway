global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    service: debt-flow-sip-gateway
    environment: local

rule_files:
  - "__RULES_PATH__"

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

scrape_configs:
  - job_name: debt-flow-sip-gateway
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:9090"]
        labels:
          node: sip-gateway-01
