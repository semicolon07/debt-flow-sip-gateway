<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <rule name="Debt Flow SIP Gateway WSS" stopProcessing="true">
          <match url="^gateway/v1$" />
          <action type="Rewrite" url="http://127.0.0.1:8080/gateway/v1" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="65536" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>

